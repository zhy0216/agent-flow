# Dedicated PostgreSQL database shared with the API. Runtime tables use public;
# business tables use agent_flow; worker journal/outbox use agent_flow_worker.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/agent_flow_dev
AGENT_FLOW_API_URL=http://127.0.0.1:3001
AGENT_FLOW_WORKER_NAME=Local Herdr worker
# Pair once in the Workers page, then bun run worker:pair --code CODE in Herdr.
# Identity is stable across restarts; do not use the same file for two workers.
# AGENT_FLOW_IDENTITY_FILE=/absolute/path/to/worker.json
# Project repoKey values refer to this worker-local map, never a browser path.
AGENT_FLOW_REPOS={"example":"/absolute/path/to/your/git-repository"}
AGENT_FLOW_POLL_MS=2000
