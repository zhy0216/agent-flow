{
  "name": "agent-flow",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup:local": "bun scripts/link-local.ts",
    "setup:deps": "bun scripts/setup-deps.ts",
    "audit:deps": "npm_config_registry=https://registry.npmjs.org bun audit",
    "db:generate": "bun run --bun drizzle-kit generate --config packages/db/drizzle.config.ts && bun run --bun drizzle-kit generate --config apps/worker/drizzle.config.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "dev": "bun run --bun turbo run dev --filter=@agent-flow/web --filter=@agent-flow/server",
    "dev:worker": "bun run --filter @agent-flow/worker dev",
    "worker:check": "bun run --filter @agent-flow/worker check",
    "worker:pair": "bun run --filter @agent-flow/worker pair",
    "worker:smoke": "bun run --filter @agent-flow/worker smoke",
    "worker:start": "bun run --filter @agent-flow/worker start",
    "build": "bun run --bun turbo run build",
    "typecheck": "bun run --bun tsc --noEmit --project scripts/tsconfig.json && bun run --bun tsc --noEmit --project tests/browser/tsconfig.json && bun run --bun turbo run typecheck",
    "test": "bun run --bun turbo run test",
    "test:setup": "bun test scripts/test/setup-deps.test.ts --timeout 30000",
    "test:integration": "bun scripts/test-integration.ts",
    "test:herdr": "bun scripts/test-herdr.ts",
    "test:browser": "bun x --no-install playwright test",
    "lint": "bun run --bun biome check .",
    "format": "bun run --bun biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run test:setup && bun run test && bun run build"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@agent-flow/contracts": "workspace:*",
    "@agent-flow/db": "workspace:*",
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "^1.63.0",
    "@types/bun": "1.4.1",
    "drizzle-kit": "0.31.10",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
